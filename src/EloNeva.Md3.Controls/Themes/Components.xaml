<!--
    Composants Material Design 3 EloNeva.
    Toutes les couleurs, formes et polices sont lues en DynamicResource depuis les jetons « Md3.* »
    fournis par un thème généré (ex. MonTheme.Light.xaml) : changer de thème met à jour les composants.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:ctl="clr-namespace:EloNeva.Md3.Controls"
                    xmlns:conv="clr-namespace:EloNeva.Md3.Controls.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <conv:NotEmptyToBooleanConverter x:Key="Md3.NotEmptyToBooleanConverter" />
    <conv:InverseBooleanConverter x:Key="Md3.InverseBooleanConverter" />

    <!-- ===================== Boutons ===================== -->

    <Style x:Key="Md3.Button.Filled" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="{DynamicResource Md3.Brush.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md3.Brush.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.Brush.OnPrimary}" />
        <Setter Property="md:ButtonAssist.CornerRadius" Value="{DynamicResource Md3.Shape.Button}" />
        <Setter Property="md:ElevationAssist.Elevation" Value="Dp0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="24,0" />
    </Style>

    <Style x:Key="Md3.Button.Tonal" TargetType="{x:Type Button}" BasedOn="{StaticResource Md3.Button.Filled}">
        <Setter Property="Background" Value="{DynamicResource Md3.Brush.SecondaryContainer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md3.Brush.SecondaryContainer}" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.Brush.OnSecondaryContainer}" />
    </Style>

    <Style x:Key="Md3.Button.Elevated" TargetType="{x:Type Button}" BasedOn="{StaticResource Md3.Button.Filled}">
        <Setter Property="Background" Value="{DynamicResource Md3.Brush.SurfaceContainerLow}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md3.Brush.SurfaceContainerLow}" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.Brush.Primary}" />
        <Setter Property="md:ElevationAssist.Elevation" Value="Dp1" />
    </Style>

    <Style x:Key="Md3.Button.Error" TargetType="{x:Type Button}" BasedOn="{StaticResource Md3.Button.Filled}">
        <Setter Property="Background" Value="{DynamicResource Md3.Brush.Error}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md3.Brush.Error}" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.Brush.OnError}" />
    </Style>

    <Style x:Key="Md3.Button.Outlined" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="BorderBrush" Value="{DynamicResource Md3.Brush.Outline}" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.Brush.Primary}" />
        <Setter Property="md:ButtonAssist.CornerRadius" Value="{DynamicResource Md3.Shape.Button}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="24,0" />
    </Style>

    <Style x:Key="Md3.Button.Text" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="Foreground" Value="{DynamicResource Md3.Brush.Primary}" />
        <Setter Property="md:ButtonAssist.CornerRadius" Value="{DynamicResource Md3.Shape.Button}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style x:Key="Md3.Button.Fab" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFloatingActionButton}">
        <Setter Property="Background" Value="{DynamicResource Md3.Brush.PrimaryContainer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md3.Brush.PrimaryContainer}" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.Brush.OnPrimaryContainer}" />
        <Setter Property="md:ElevationAssist.Elevation" Value="Dp3" />
    </Style>

    <Style x:Key="Md3.Button.Icon" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignIconButton}">
        <Setter Property="Foreground" Value="{DynamicResource Md3.Brush.OnSurfaceVariant}" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
    </Style>

    <!-- ===================== Champs ===================== -->

    <Style x:Key="Md3.TextBox.Outlined" TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="{DynamicResource Md3.Shape.Field}" />
        <Setter Property="md:HintAssist.Background" Value="{DynamicResource Md3.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md3.Brush.Outline}" />
    </Style>

    <Style x:Key="Md3.TextBox.Filled" TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignFilledTextBox}">
        <Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="{DynamicResource Md3.Shape.FieldFilled}" />
        <Setter Property="Background" Value="{DynamicResource Md3.Brush.SurfaceContainerHighest}" />
    </Style>

    <Style x:Key="Md3.PasswordBox.Outlined" TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
        <Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="{DynamicResource Md3.Shape.Field}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md3.Brush.Outline}" />
    </Style>

    <Style x:Key="Md3.ComboBox.Outlined" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
        <Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="{DynamicResource Md3.Shape.Field}" />
        <Setter Property="md:HintAssist.Background" Value="{DynamicResource Md3.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md3.Brush.Outline}" />
    </Style>

    <Style x:Key="Md3.ComboBox.Filled" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignFilledComboBox}">
        <Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="{DynamicResource Md3.Shape.FieldFilled}" />
        <Setter Property="Background" Value="{DynamicResource Md3.Brush.SurfaceContainerHighest}" />
    </Style>

    <Style x:Key="Md3.DatePicker.Outlined" TargetType="{x:Type DatePicker}" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
        <Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="{DynamicResource Md3.Shape.Field}" />
        <Setter Property="md:HintAssist.Background" Value="{DynamicResource Md3.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md3.Brush.Outline}" />
    </Style>

    <Style x:Key="Md3.DatePicker.Filled" TargetType="{x:Type DatePicker}" BasedOn="{StaticResource MaterialDesignFilledDatePicker}">
        <Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="{DynamicResource Md3.Shape.FieldFilled}" />
    </Style>

    <!-- ===================== Chips (ListBox) ===================== -->

    <Style x:Key="Md3.ChipItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.Brush.OnSurfaceVariant}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Chip" CornerRadius="{DynamicResource Md3.Shape.Small}" BorderThickness="1"
                            BorderBrush="{DynamicResource Md3.Brush.Outline}" Background="Transparent">
                        <Grid>
                            <Border x:Name="State" CornerRadius="{DynamicResource Md3.Shape.Small}"
                                    Background="{DynamicResource Md3.Brush.OnSurface}" Opacity="0" />
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                                <md:PackIcon x:Name="Check" Kind="Check" Width="18" Height="18" Margin="-8,0,8,0"
                                             VerticalAlignment="Center" Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" TextElement.FontWeight="Medium" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="State" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Md3.Brush.SecondaryContainer}" />
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Md3.Brush.SecondaryContainer}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Md3.Brush.OnSecondaryContainer}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chips de choix (SelectionMode=Single) ou de filtre (SelectionMode=Multiple). -->
    <Style x:Key="Md3.ChipListBox" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Md3.ChipItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Cartes ===================== -->

    <Style x:Key="Md3.Card.Elevated" TargetType="{x:Type md:Card}" BasedOn="{StaticResource MaterialDesignElevatedCard}">
        <Setter Property="UniformCornerRadius" Value="{DynamicResource Md3.Shape.Card}" />
        <Setter Property="Background" Value="{DynamicResource Md3.Brush.SurfaceContainerLow}" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.Brush.OnSurface}" />
        <Setter Property="md:ElevationAssist.Elevation" Value="Dp1" />
    </Style>

    <Style x:Key="Md3.Card.Filled" TargetType="{x:Type md:Card}" BasedOn="{StaticResource Md3.Card.Elevated}">
        <Setter Property="Background" Value="{DynamicResource Md3.Brush.SurfaceContainerHighest}" />
        <Setter Property="md:ElevationAssist.Elevation" Value="Dp0" />
    </Style>

    <Style x:Key="Md3.Card.Outlined" TargetType="{x:Type md:Card}" BasedOn="{StaticResource MaterialDesignOutlinedCard}">
        <Setter Property="UniformCornerRadius" Value="{DynamicResource Md3.Shape.Card}" />
        <Setter Property="Background" Value="{DynamicResource Md3.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md3.Brush.OutlineVariant}" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.Brush.OnSurface}" />
    </Style>

    <!-- ===================== Table avec filtre par colonne ===================== -->

    <Style x:Key="Md3.FilterToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.Brush.OnSurfaceVariant}" />
        <Setter Property="ToolTip" Value="Filtrer" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Ellipse x:Name="State" Fill="{TemplateBinding Foreground}" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="State" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="State" Property="Opacity" Value="0.12" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Md3.DataGridColumnHeader.Filter" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource Md3.Brush.SurfaceContainer}" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.Brush.OnSurfaceVariant}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Md3.Brush.OutlineVariant}"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                                <md:PackIcon x:Name="SortIcon" Grid.Column="1" Width="16" Height="16" Margin="4,0,0,0"
                                             VerticalAlignment="Center" Kind="ArrowUp" Visibility="Collapsed" />
                                <ToggleButton x:Name="FilterToggle" Grid.Column="2" Style="{StaticResource Md3.FilterToggle}"
                                              IsHitTestVisible="{Binding IsOpen, ElementName=FilterPopup, Converter={StaticResource Md3.InverseBooleanConverter}}">
                                    <md:PackIcon x:Name="FilterIcon" Kind="FilterOutline" Width="16" Height="16" />
                                </ToggleButton>
                            </Grid>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource MaterialDesignGridColumnHeaderGripper}" />
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignGridColumnHeaderGripper}" />

                        <Popup x:Name="FilterPopup"
                               IsOpen="{Binding IsChecked, ElementName=FilterToggle, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=FilterToggle}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <md:Card Margin="8" Padding="16,12" MinWidth="240"
                                     Style="{StaticResource Md3.Card.Elevated}"
                                     Background="{DynamicResource Md3.Brush.SurfaceContainerHigh}"
                                     md:ElevationAssist.Elevation="Dp3"
                                     FocusManager.FocusedElement="{Binding ElementName=PART_FilterBox}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,12" Style="{StaticResource MaterialDesignTitleSmallTextBlock}"
                                               Foreground="{DynamicResource Md3.Brush.OnSurface}">
                                        <Run Text="Filtrer :" />
                                        <Run Text="{Binding Column.Header, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBox x:Name="PART_FilterBox"
                                             Style="{StaticResource Md3.TextBox.Outlined}"
                                             md:HintAssist.Hint="Contient…"
                                             md:HintAssist.Background="{DynamicResource Md3.Brush.SurfaceContainerHigh}"
                                             md:TextFieldAssist.HasClearButton="True"
                                             md:TextFieldAssist.HasLeadingIcon="True"
                                             md:TextFieldAssist.LeadingIcon="Magnify"
                                             Text="{Binding Column.(ctl:FilterDataGrid.FilterText), RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </md:Card>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortIcon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortIcon" Property="Kind" Value="ArrowDown" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Column.(ctl:FilterDataGrid.FilterText), RelativeSource={RelativeSource Self}, Converter={StaticResource Md3.NotEmptyToBooleanConverter}}" Value="True">
                            <Setter TargetName="FilterIcon" Property="Kind" Value="Filter" />
                            <Setter TargetName="FilterToggle" Property="Foreground" Value="{DynamicResource Md3.Brush.Primary}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Column.(ctl:FilterDataGrid.IsFilterable), RelativeSource={RelativeSource Self}}" Value="False">
                            <Setter TargetName="FilterToggle" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Column, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                            <Setter TargetName="FilterToggle" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Md3.FilterDataGrid" TargetType="{x:Type ctl:FilterDataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}">
        <Style.Resources>
            <!-- Style implicite local : prime sur le style implicite global de MaterialDesign pour les en-têtes. -->
            <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource Md3.DataGridColumnHeader.Filter}" />
        </Style.Resources>
        <Setter Property="Background" Value="{DynamicResource Md3.Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.Brush.OnSurface}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource Md3.DataGridColumnHeader.Filter}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <!-- Réutilise les lignes à l'écran au lieu de les recréer à chaque filtrage ou défilement. -->
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>
    <Style TargetType="{x:Type ctl:FilterDataGrid}" BasedOn="{StaticResource Md3.FilterDataGrid}" />

    <!-- ===================== Sélecteur de plage de dates ===================== -->

    <Style x:Key="Md3.DateRangePicker" TargetType="{x:Type ctl:DateRangePicker}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:DateRangePicker}">
                    <Grid>
                        <TextBox x:Name="PART_Field"
                                 Style="{StaticResource Md3.TextBox.Outlined}"
                                 IsReadOnly="True" Cursor="Hand"
                                 Text="{Binding DisplayText, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                 md:HintAssist.Hint="{TemplateBinding Hint}"
                                 md:TextFieldAssist.HasTrailingIcon="True"
                                 md:TextFieldAssist.TrailingIcon="CalendarRange" />
                        <Popup IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=PART_Field}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <md:Card Margin="8" Style="{StaticResource Md3.Card.Elevated}"
                                     Background="{DynamicResource Md3.Brush.SurfaceContainerHigh}"
                                     md:ElevationAssist.Elevation="Dp3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Margin="8,16,0,8">
                                        <TextBlock Margin="12,0,0,8" Text="Raccourcis"
                                                   Style="{StaticResource MaterialDesignLabelLargeTextBlock}"
                                                   Foreground="{DynamicResource Md3.Brush.OnSurfaceVariant}" />
                                        <Button Style="{StaticResource Md3.Button.Text}" HorizontalContentAlignment="Left" Content="Aujourd'hui"
                                                Command="ctl:DateRangePicker.ApplyPresetCommand" CommandParameter="Today"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                        <Button Style="{StaticResource Md3.Button.Text}" HorizontalContentAlignment="Left" Content="7 derniers jours"
                                                Command="ctl:DateRangePicker.ApplyPresetCommand" CommandParameter="Last7Days"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                        <Button Style="{StaticResource Md3.Button.Text}" HorizontalContentAlignment="Left" Content="30 derniers jours"
                                                Command="ctl:DateRangePicker.ApplyPresetCommand" CommandParameter="Last30Days"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                        <Button Style="{StaticResource Md3.Button.Text}" HorizontalContentAlignment="Left" Content="Ce mois-ci"
                                                Command="ctl:DateRangePicker.ApplyPresetCommand" CommandParameter="ThisMonth"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                        <Button Style="{StaticResource Md3.Button.Text}" HorizontalContentAlignment="Left" Content="Cette année"
                                                Command="ctl:DateRangePicker.ApplyPresetCommand" CommandParameter="ThisYear"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                    </StackPanel>

                                    <Calendar x:Name="PART_Calendar" Grid.Column="1" Margin="8"
                                              md:CalendarAssist.IsHeaderVisible="False" />

                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="8" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource Md3.Button.Text}" Content="Effacer"
                                                Command="ctl:DateRangePicker.ClearCommand"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                        <Button Style="{StaticResource Md3.Button.Text}" Content="OK"
                                                Command="ctl:DateRangePicker.CloseCommand"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                    </StackPanel>
                                </Grid>
                            </md:Card>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ctl:DateRangePicker}" BasedOn="{StaticResource Md3.DateRangePicker}" />

</ResourceDictionary>
