<UserControl x:Class="EloNevaThemeGenerator.Views.ColorEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="96" />
        </Grid.ColumnDefinitions>

        <ToggleButton x:Name="SwatchButton" Width="32" Height="32" Cursor="Hand"
                      ToolTip="Choisir une couleur"
                      IsHitTestVisible="{Binding IsOpen, ElementName=PickerPopup, Converter={StaticResource Md3.InverseBooleanConverter}}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border CornerRadius="16" BorderThickness="1"
                            BorderBrush="{DynamicResource Md3.Brush.Outline}">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding Color, ElementName=Root}" />
                        </Border.Background>
                    </Border>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <TextBlock Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"
                   Text="{Binding Label, ElementName=Root}" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Label, ElementName=Root}" />

        <TextBox x:Name="HexBox" Grid.Column="2" VerticalAlignment="Center"
                 FontFamily="Consolas" CharacterCasing="Upper"
                 LostKeyboardFocus="OnHexLostFocus" KeyDown="OnHexKeyDown" />

        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=SwatchButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               IsOpen="{Binding IsChecked, ElementName=SwatchButton, Mode=TwoWay}">
            <md:Card Margin="8" Padding="12" Style="{StaticResource Md3.Card.Elevated}"
                     Background="{DynamicResource Md3.Brush.SurfaceContainerHigh}"
                     md:ElevationAssist.Elevation="Dp3">
                <md:ColorPicker Width="280" Height="200"
                                Color="{Binding Color, ElementName=Root, Mode=TwoWay}" />
            </md:Card>
        </Popup>
    </Grid>
</UserControl>
