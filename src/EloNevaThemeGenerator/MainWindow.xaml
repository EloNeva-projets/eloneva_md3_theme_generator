<Window x:Class="EloNevaThemeGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:ctl="clr-namespace:EloNeva.Md3.Controls;assembly=EloNeva.Md3.Controls"
        xmlns:views="clr-namespace:EloNevaThemeGenerator.Views"
        xmlns:vm="clr-namespace:EloNevaThemeGenerator.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Width="1500" Height="940" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{DynamicResource Md3.Brush.Surface}"
        Foreground="{DynamicResource Md3.Brush.OnSurface}"
        TextElement.Foreground="{DynamicResource Md3.Brush.OnSurface}"
        FontFamily="{DynamicResource Md3.FontFamily}"
        FontSize="{DynamicResource Md3.FontSize}"
        TextOptions.TextFormattingMode="Ideal"
        Closing="OnClosing">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <x:Array x:Key="PresetColors" Type="sys:String">
            <sys:String>#6750A4</sys:String>
            <sys:String>#0061A4</sys:String>
            <sys:String>#006A6A</sys:String>
            <sys:String>#006E1C</sys:String>
            <sys:String>#9CC93A</sys:String>
            <sys:String>#8B5000</sys:String>
            <sys:String>#BA1A1A</sys:String>
            <sys:String>#984061</sys:String>
            <sys:String>#3F5F90</sys:String>
            <sys:String>#212121</sys:String>
        </x:Array>

        <Style x:Key="SectionCard" TargetType="md:Card" BasedOn="{StaticResource Md3.Card.Outlined}">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="EditorCard" TargetType="md:Card" BasedOn="{StaticResource Md3.Card.Filled}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource Md3.Brush.SurfaceContainer}" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTitleMediumTextBlock}">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Foreground" Value="{DynamicResource Md3.Brush.OnSurface}" />
        </Style>

        <Style x:Key="SubTitle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignLabelLargeTextBlock}">
            <Setter Property="Margin" Value="0,8,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource Md3.Brush.OnSurfaceVariant}" />
        </Style>

        <Style x:Key="SliderLabel" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBodyMediumTextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Gap" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== Barre d'application ===================== -->
        <Border Background="{DynamicResource Md3.Brush.SurfaceContainer}" Padding="16,8">
            <DockPanel LastChildFill="False">
                <md:PackIcon DockPanel.Dock="Left" Kind="PaletteSwatchVariant" Width="28" Height="28"
                             VerticalAlignment="Center" Foreground="{DynamicResource Md3.Brush.Primary}" />
                <StackPanel DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource MaterialDesignTitleLargeTextBlock}" Text="EloNeva MD3 Theme Generator" />
                    <TextBlock Style="{StaticResource MaterialDesignBodySmallTextBlock}" Text="{Binding FileLabel}"
                               Foreground="{DynamicResource Md3.Brush.OnSurfaceVariant}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <md:PackIcon Kind="WhiteBalanceSunny" VerticalAlignment="Center" Foreground="{DynamicResource Md3.Brush.OnSurfaceVariant}" />
                    <ToggleButton Margin="8,0" Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  IsChecked="{Binding IsDark}" ToolTip="Mode clair / sombre" />
                    <md:PackIcon Kind="WeatherNight" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource Md3.Brush.OnSurfaceVariant}" />

                    <Button Style="{StaticResource Md3.Button.Icon}" Command="{Binding NewCommand}" ToolTip="Nouveau thème (Ctrl+N)">
                        <md:PackIcon Kind="FilePlusOutline" />
                    </Button>
                    <Button Style="{StaticResource Md3.Button.Icon}" Command="{Binding OpenCommand}" ToolTip="Ouvrir (Ctrl+O)">
                        <md:PackIcon Kind="FolderOpenOutline" />
                    </Button>
                    <Button Style="{StaticResource Md3.Button.Icon}" Command="{Binding SaveCommand}" ToolTip="Enregistrer (Ctrl+S)">
                        <md:PackIcon Kind="ContentSaveOutline" />
                    </Button>
                    <Button Style="{StaticResource Md3.Button.Icon}" Command="{Binding SaveAsCommand}" ToolTip="Enregistrer sous (Ctrl+Maj+S)">
                        <md:PackIcon Kind="ContentSaveEditOutline" />
                    </Button>
                    <Button Margin="12,0,0,0" Style="{StaticResource Md3.Button.Filled}" Command="{Binding ExportCommand}" ToolTip="Exporter les ResourceDictionary clair et sombre (Ctrl+E)">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Xml" Margin="0,0,8,0" />
                            <TextBlock Text="Exporter XAML" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===================== Éditeur du thème ===================== -->
            <Border Background="{DynamicResource Md3.Brush.SurfaceContainerLow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">

                        <md:Card Style="{StaticResource EditorCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Identité" />
                                <TextBox Style="{StaticResource Md3.TextBox.Outlined}" md:HintAssist.Hint="Nom du thème"
                                         md:HintAssist.Background="{DynamicResource Md3.Brush.SurfaceContainer}"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </md:Card>

                        <md:Card Style="{StaticResource EditorCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Couleurs sources" />

                                <TextBlock Style="{StaticResource SubTitle}" Margin="0,0,0,8" Text="Couleurs rapides" />
                                <ItemsControl ItemsSource="{StaticResource PresetColors}" Margin="0,0,0,12">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="28" Height="28" Margin="0,0,6,6" Cursor="Hand" ToolTip="{Binding}"
                                                    Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Ellipse Fill="{Binding}" Stroke="{DynamicResource Md3.Brush.OutlineVariant}" />
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <views:ColorEditor Margin="0,0,0,8" Label="Primaire" Color="{Binding PrimarySeed}" />
                                <views:ColorEditor Margin="0,0,0,8" Label="Secondaire" Color="{Binding SecondarySeed}" />
                                <views:ColorEditor Margin="0,0,0,8" Label="Tertiaire" Color="{Binding TertiarySeed}" />
                                <views:ColorEditor Margin="0,0,0,8" Label="Erreur" Color="{Binding ErrorSeed}" />
                                <views:ColorEditor Margin="0,0,0,8" Label="Neutre (surfaces)" Color="{Binding NeutralSeed}" />
                                <views:ColorEditor Margin="0,0,0,12" Label="Neutre variante (contours)" Color="{Binding NeutralVariantSeed}" />

                                <CheckBox Margin="0,0,0,8" IsChecked="{Binding ExactPrimary}"
                                          Content="Primaire = couleur exacte (marque, mode clair)" />
                                <CheckBox Margin="0,0,0,12" IsChecked="{Binding AutoDeriveSeeds}"
                                          Content="Dériver les autres couleurs du primaire" />
                                <Button HorizontalAlignment="Left" Style="{StaticResource Md3.Button.Tonal}" Command="{Binding DeriveSeedsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="AutoFix" Margin="0,0,8,0" />
                                        <TextBlock Text="Harmoniser depuis le primaire" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </md:Card>

                        <md:Card Style="{StaticResource EditorCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Formes (rayons)" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource SliderLabel}" Text="Boutons" />
                                    <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ButtonCornerRadius}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource SliderLabel}" HorizontalAlignment="Right" Text="{Binding ButtonCornerRadius}" />

                                    <TextBlock Grid.Row="1" Style="{StaticResource SliderLabel}" Text="Champs" />
                                    <Slider Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FieldCornerRadius}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource SliderLabel}" HorizontalAlignment="Right" Text="{Binding FieldCornerRadius}" />

                                    <TextBlock Grid.Row="2" Style="{StaticResource SliderLabel}" Text="Cartes" />
                                    <Slider Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="28" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CardCornerRadius}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource SliderLabel}" HorizontalAlignment="Right" Text="{Binding CardCornerRadius}" />

                                    <TextBlock Grid.Row="3" Style="{StaticResource SliderLabel}" Text="Petits éléments" />
                                    <Slider Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SmallCornerRadius}" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource SliderLabel}" HorizontalAlignment="Right" Text="{Binding SmallCornerRadius}" />
                                </Grid>
                            </StackPanel>
                        </md:Card>

                        <md:Card Style="{StaticResource EditorCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Typographie" />
                                <ComboBox Style="{StaticResource Md3.ComboBox.Outlined}" md:HintAssist.Hint="Police"
                                          md:HintAssist.Background="{DynamicResource Md3.Brush.SurfaceContainer}"
                                          ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding FontFamily}"
                                          MaxDropDownHeight="360">
                                    <ComboBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ComboBox.ItemsPanel>
                                </ComboBox>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SliderLabel}" Text="Taille de base" />
                                    <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="11" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FontSize}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource SliderLabel}" HorizontalAlignment="Right" Text="{Binding FontSize}" />
                                </Grid>
                            </StackPanel>
                        </md:Card>

                        <md:Card Style="{StaticResource EditorCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Md3.Button.Text}" Content="Tout réinitialiser"
                                            Command="{Binding ResetOverridesCommand}" ToolTip="Supprimer toutes les surcharges du mode courant" />
                                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" Text="Rôles de couleur" />
                                </DockPanel>
                                <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Style="{StaticResource MaterialDesignBodySmallTextBlock}"
                                           Foreground="{DynamicResource Md3.Brush.OnSurfaceVariant}"
                                           Text="Calculés depuis les couleurs sources. Modifier un rôle le surcharge pour le mode courant (clair ou sombre)." />
                                <ItemsControl ItemsSource="{Binding RolesView}">
                                    <ItemsControl.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{StaticResource SubTitle}" Margin="0,12,0,6" Text="{Binding Name}" />
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ItemsControl.GroupStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ColorRoleViewModel">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="32" />
                                                </Grid.ColumnDefinitions>
                                                <views:ColorEditor Label="{Binding Name}" Color="{Binding Color}" />
                                                <Button Grid.Column="1" Width="28" Height="28" Padding="0"
                                                        Style="{StaticResource Md3.Button.Icon}" Command="{Binding ResetCommand}"
                                                        ToolTip="Revenir à la valeur calculée"
                                                        Visibility="{Binding IsOverridden, Converter={StaticResource BoolToVisibility}}">
                                                    <md:PackIcon Kind="Restore" Width="18" Height="18" Foreground="{DynamicResource Md3.Brush.Primary}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </md:Card>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===================== Aperçu ===================== -->
            <TabControl Grid.Column="1" Background="{DynamicResource Md3.Brush.Surface}" md:ColorZoneAssist.Mode="Standard">

                <TabItem Header="Composants">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">

                            <!-- Boutons -->
                            <md:Card Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Boutons" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource Md3.Button.Filled}" Margin="0,0,12,12" Content="Filled" />
                                        <Button Style="{StaticResource Md3.Button.Tonal}" Margin="0,0,12,12" Content="Tonal" />
                                        <Button Style="{StaticResource Md3.Button.Elevated}" Margin="0,0,12,12" Content="Elevated" />
                                        <Button Style="{StaticResource Md3.Button.Outlined}" Margin="0,0,12,12" Content="Outlined" />
                                        <Button Style="{StaticResource Md3.Button.Text}" Margin="0,0,12,12" Content="Text" />
                                        <Button Style="{StaticResource Md3.Button.Error}" Margin="0,0,12,12" Content="Supprimer" />
                                        <Button Style="{StaticResource Md3.Button.Filled}" Margin="0,0,12,12" Content="Désactivé" IsEnabled="False" />
                                        <Button Style="{StaticResource Md3.Button.Filled}" Margin="0,0,12,12">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="Plus" Margin="0,0,8,0" />
                                                <TextBlock Text="Avec icône" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Md3.Button.Outlined}" Margin="0,0,12,12" Command="{Binding ShowSnackbarCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="MessageOutline" Margin="0,0,8,0" />
                                                <TextBlock Text="Snackbar" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <Button Style="{StaticResource Md3.Button.Icon}" Margin="0,0,8,0" ToolTip="Favori">
                                            <md:PackIcon Kind="HeartOutline" />
                                        </Button>
                                        <Button Style="{StaticResource Md3.Button.Icon}" Margin="0,0,8,0" ToolTip="Partager">
                                            <md:PackIcon Kind="ShareVariantOutline" />
                                        </Button>
                                        <Button Style="{StaticResource Md3.Button.Icon}" Margin="0,0,24,0" ToolTip="Supprimer">
                                            <md:PackIcon Kind="DeleteOutline" />
                                        </Button>
                                        <Button Style="{StaticResource Md3.Button.Fab}" Margin="0,0,16,0" ToolTip="Créer">
                                            <md:PackIcon Kind="Pencil" Width="24" Height="24" />
                                        </Button>
                                        <md:Badged Badge="3" VerticalAlignment="Center" BadgeBackground="{DynamicResource Md3.Brush.Error}" BadgeForeground="{DynamicResource Md3.Brush.OnError}">
                                            <Button Style="{StaticResource Md3.Button.Tonal}" Content="Notifications" />
                                        </md:Badged>
                                    </WrapPanel>
                                </StackPanel>
                            </md:Card>

                            <!-- Champs de saisie -->
                            <md:Card Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Champs de saisie" />
                                    <UniformGrid Columns="3">
                                        <TextBox Style="{StaticResource Md3.TextBox.Outlined}" Margin="0,0,16,24"
                                                 md:HintAssist.Hint="Nom" md:HintAssist.HelperText="Texte d'aide" Text="Dupont" />
                                        <TextBox Style="{StaticResource Md3.TextBox.Filled}" Margin="0,0,16,24"
                                                 md:HintAssist.Hint="Prénom (filled)" Text="Camille" />
                                        <TextBox Style="{StaticResource Md3.TextBox.Outlined}" Margin="0,0,16,24"
                                                 md:HintAssist.Hint="E-mail" md:TextFieldAssist.HasLeadingIcon="True"
                                                 md:TextFieldAssist.LeadingIcon="EmailOutline" md:TextFieldAssist.HasClearButton="True"
                                                 Text="camille.dupont@exemple.fr" />
                                        <PasswordBox Style="{StaticResource Md3.PasswordBox.Outlined}" Margin="0,0,16,24"
                                                     md:HintAssist.Hint="Mot de passe" />
                                        <TextBox Style="{StaticResource Md3.TextBox.Outlined}" Margin="0,0,16,24"
                                                 md:HintAssist.Hint="Montant" md:TextFieldAssist.SuffixText="€" Text="1 250,00" />
                                        <TextBox Style="{StaticResource Md3.TextBox.Outlined}" Margin="0,0,16,24"
                                                 md:HintAssist.Hint="Champ en erreur" Text="valeur invalide"
                                                 BorderBrush="{DynamicResource Md3.Brush.Error}"
                                                 md:HintAssist.Foreground="{DynamicResource Md3.Brush.Error}"
                                                 md:TextFieldAssist.UnderlineBrush="{DynamicResource Md3.Brush.Error}"
                                                 md:HintAssist.HelperText="Format attendu : AAAA-0000" />
                                    </UniformGrid>
                                    <TextBox Style="{StaticResource Md3.TextBox.Outlined}" Height="96" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top" md:HintAssist.Hint="Commentaire (multiligne)"
                                             Text="Texte sur plusieurs lignes…" Margin="0,0,16,0" />
                                </StackPanel>
                            </md:Card>

                            <!-- Sélecteurs -->
                            <md:Card Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Sélecteurs" />
                                    <UniformGrid Columns="3">
                                        <ComboBox Style="{StaticResource Md3.ComboBox.Outlined}" Margin="0,0,16,16"
                                                  md:HintAssist.Hint="Service" ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" />
                                        <ComboBox Style="{StaticResource Md3.ComboBox.Filled}" Margin="0,0,16,16"
                                                  md:HintAssist.Hint="Service (filled)" ItemsSource="{Binding Services}" SelectedIndex="0" />
                                        <ComboBox Style="{StaticResource Md3.ComboBox.Outlined}" Margin="0,0,16,16" IsEditable="True"
                                                  md:HintAssist.Hint="Saisie libre / liste" ItemsSource="{Binding Services}" />
                                    </UniformGrid>

                                    <TextBlock Style="{StaticResource SubTitle}" Text="Chips de choix (sélection unique)" />
                                    <ListBox Style="{StaticResource Md3.ChipListBox}" SelectedIndex="1">
                                        <ListBoxItem Content="Jour" />
                                        <ListBoxItem Content="Semaine" />
                                        <ListBoxItem Content="Mois" />
                                        <ListBoxItem Content="Année" />
                                    </ListBox>

                                    <TextBlock Style="{StaticResource SubTitle}" Text="Chips de filtre (sélection multiple)" />
                                    <ListBox Style="{StaticResource Md3.ChipListBox}" SelectionMode="Multiple"
                                             ItemsSource="{Binding Services}" />

                                    <WrapPanel Margin="0,16,0,0">
                                        <StackPanel Margin="0,0,40,0">
                                            <TextBlock Style="{StaticResource SubTitle}" Text="Cases à cocher" />
                                            <CheckBox Content="Télétravail" IsChecked="True" Margin="0,0,0,8" />
                                            <CheckBox Content="Temps partiel" Margin="0,0,0,8" />
                                            <CheckBox Content="Désactivée" IsEnabled="False" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,40,0">
                                            <TextBlock Style="{StaticResource SubTitle}" Text="Boutons radio" />
                                            <RadioButton Content="CDI" GroupName="Contrat" IsChecked="True" Margin="0,0,0,8" />
                                            <RadioButton Content="CDD" GroupName="Contrat" Margin="0,0,0,8" />
                                            <RadioButton Content="Intérim" GroupName="Contrat" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,40,0">
                                            <TextBlock Style="{StaticResource SubTitle}" Text="Interrupteurs" />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="True" />
                                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Notifications" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Mode compact" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Width="260">
                                            <TextBlock Style="{StaticResource SubTitle}" Text="{Binding SliderValue, StringFormat='Curseur : {0:0}'}" />
                                            <Slider Minimum="0" Maximum="100" Value="{Binding SliderValue}" />
                                            <ProgressBar Margin="0,16,0,0" Value="{Binding SliderValue}" />
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </md:Card>

                            <!-- Dates -->
                            <md:Card Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Dates" />
                                    <UniformGrid Columns="4">
                                        <DatePicker Style="{StaticResource Md3.DatePicker.Outlined}" Margin="0,0,16,16"
                                                    md:HintAssist.Hint="Date d'effet" SelectedDate="{Binding SelectedDate}" />
                                        <DatePicker Style="{StaticResource Md3.DatePicker.Filled}" Margin="0,0,16,16"
                                                    md:HintAssist.Hint="Date (filled)" SelectedDate="{Binding SelectedDate}" />
                                        <ctl:DateRangePicker Margin="0,0,16,16" Hint="Période"
                                                             StartDate="{Binding RangeStart}" EndDate="{Binding RangeEnd}" />
                                        <md:TimePicker Style="{StaticResource MaterialDesignOutlinedTimePicker}" Margin="0,0,16,16"
                                                       md:HintAssist.Hint="Heure" Is24Hours="True"
                                                       md:TextFieldAssist.TextFieldCornerRadius="{DynamicResource Md3.Shape.Field}" />
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource MaterialDesignBodyMediumTextBlock}" Foreground="{DynamicResource Md3.Brush.OnSurfaceVariant}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="Période sélectionnée : du {0:d} au {1:d}" TargetNullValue="—">
                                                <Binding Path="RangeStart" />
                                                <Binding Path="RangeEnd" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </md:Card>

                            <!-- Listes -->
                            <md:Card Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Listes" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ListBox ItemsSource="{Binding Messages}" SelectedIndex="0" HorizontalContentAlignment="Stretch">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="vm:ListEntry">
                                                    <Grid Margin="4,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Md3.Brush.PrimaryContainer}">
                                                            <md:PackIcon Kind="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource Md3.Brush.OnPrimaryContainer}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource MaterialDesignBodyLargeTextBlock}" Text="{Binding Title}" />
                                                            <TextBlock Style="{StaticResource MaterialDesignBodyMediumTextBlock}" Text="{Binding Subtitle}"
                                                                       Foreground="{DynamicResource Md3.Brush.OnSurfaceVariant}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Style="{StaticResource MaterialDesignLabelSmallTextBlock}" Text="{Binding Trailing}"
                                                                   Foreground="{DynamicResource Md3.Brush.OnSurfaceVariant}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <ListBox Grid.Column="2" ItemsSource="{Binding Services}" SelectionMode="Multiple">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox IsHitTestVisible="False" Focusable="False"
                                                                  IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </StackPanel>
                            </md:Card>

                            <!-- Table avec filtres -->
                            <md:Card Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Md3.Button.Text}" Click="OnClearFilters">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="FilterRemoveOutline" Margin="0,0,8,0" />
                                                <TextBlock Text="Effacer les filtres" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" Text="Table avec filtre par colonne" />
                                    </DockPanel>
                                    <TextBlock Margin="0,0,0,12" Style="{StaticResource MaterialDesignBodySmallTextBlock}"
                                               Foreground="{DynamicResource Md3.Brush.OnSurfaceVariant}"
                                               Text="{Binding FilteredCount, ElementName=EmployeesGrid, StringFormat='Cliquez sur l’icône filtre d’un en-tête. {0} ligne(s) affichée(s).'}" />
                                    <Border CornerRadius="{DynamicResource Md3.Shape.Small}" BorderThickness="1"
                                            BorderBrush="{DynamicResource Md3.Brush.OutlineVariant}" ClipToBounds="True">
                                        <ctl:FilterDataGrid x:Name="EmployeesGrid" ItemsSource="{Binding Employees}" Height="420" IsReadOnly="True">
                                            <ctl:FilterDataGrid.Columns>
                                                <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" />
                                                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" />
                                                <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" />
                                                <DataGridTextColumn Header="Service" Binding="{Binding Service}" />
                                                <DataGridTextColumn Header="Ville" Binding="{Binding Ville}" />
                                                <DataGridTextColumn Header="Embauche" Binding="{Binding DateEmbauche, StringFormat=d}" />
                                                <DataGridTextColumn Header="Salaire" Binding="{Binding Salaire, StringFormat=C0}" ctl:FilterDataGrid.IsFilterable="False" />
                                                <DataGridTemplateColumn Header="Statut" SortMemberPath="Statut">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate DataType="vm:Employee">
                                                            <Border HorizontalAlignment="Left" Padding="10,2" CornerRadius="{DynamicResource Md3.Shape.Small}"
                                                                    Background="{DynamicResource Md3.Brush.SecondaryContainer}">
                                                                <TextBlock Text="{Binding Statut}" Style="{StaticResource MaterialDesignLabelMediumTextBlock}"
                                                                           Foreground="{DynamicResource Md3.Brush.OnSecondaryContainer}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </ctl:FilterDataGrid.Columns>
                                        </ctl:FilterDataGrid>
                                    </Border>
                                </StackPanel>
                            </md:Card>

                            <!-- Cartes et progression -->
                            <md:Card Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Cartes et indicateurs" />
                                    <UniformGrid Columns="3">
                                        <md:Card Style="{StaticResource Md3.Card.Elevated}" Margin="0,0,16,0" Padding="16">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource MaterialDesignTitleMediumTextBlock}" Text="Carte élevée" />
                                                <TextBlock Margin="0,4,0,12" TextWrapping="Wrap" Style="{StaticResource MaterialDesignBodyMediumTextBlock}"
                                                           Foreground="{DynamicResource Md3.Brush.OnSurfaceVariant}" Text="Surface container low + ombre niveau 1." />
                                                <Button HorizontalAlignment="Right" Style="{StaticResource Md3.Button.Text}" Content="Action" />
                                            </StackPanel>
                                        </md:Card>
                                        <md:Card Style="{StaticResource Md3.Card.Filled}" Margin="0,0,16,0" Padding="16">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource MaterialDesignTitleMediumTextBlock}" Text="Carte pleine" />
                                                <TextBlock Margin="0,4,0,12" TextWrapping="Wrap" Style="{StaticResource MaterialDesignBodyMediumTextBlock}"
                                                           Foreground="{DynamicResource Md3.Brush.OnSurfaceVariant}" Text="Surface container highest, sans ombre." />
                                                <Button HorizontalAlignment="Right" Style="{StaticResource Md3.Button.Tonal}" Content="Action" />
                                            </StackPanel>
                                        </md:Card>
                                        <md:Card Style="{StaticResource Md3.Card.Outlined}" Margin="0,0,16,0" Padding="16">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource MaterialDesignTitleMediumTextBlock}" Text="Carte contour" />
                                                <TextBlock Margin="0,4,0,12" TextWrapping="Wrap" Style="{StaticResource MaterialDesignBodyMediumTextBlock}"
                                                           Foreground="{DynamicResource Md3.Brush.OnSurfaceVariant}" Text="Surface + contour outline variant." />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Margin="0,0,12,0" />
                                                    <Button Style="{StaticResource Md3.Button.Outlined}" Content="Action" />
                                                </StackPanel>
                                            </StackPanel>
                                        </md:Card>
                                    </UniformGrid>
                                </StackPanel>
                            </md:Card>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Palette">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl Margin="24" ItemsSource="{Binding Roles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ColorRoleViewModel">
                                    <Border Width="200" Height="84" Margin="0,0,12,12" Padding="12"
                                            CornerRadius="{DynamicResource Md3.Shape.Small}" Background="{Binding Brush}"
                                            BorderThickness="1" BorderBrush="{DynamicResource Md3.Brush.OutlineVariant}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="{Binding ContentBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Hex}" FontFamily="Consolas" Foreground="{Binding ContentBrush}" Margin="0,4,0,0" />
                                            <TextBlock Text="surchargé" Foreground="{Binding ContentBrush}" FontStyle="Italic" FontSize="11"
                                                       Visibility="{Binding IsOverridden, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="XAML généré">
                    <DockPanel Margin="24">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Style="{StaticResource Md3.Button.Tonal}" Command="{Binding CopyXamlCommand}" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="ContentCopy" Margin="0,0,8,0" />
                                    <TextBlock Text="Copier" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Md3.Button.Outlined}" Command="{Binding ExportCommand}" Content="Exporter clair + sombre…" />
                            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource MaterialDesignBodySmallTextBlock}"
                                       Foreground="{DynamicResource Md3.Brush.OnSurfaceVariant}"
                                       Text="Aperçu du ResourceDictionary pour le mode courant." />
                        </StackPanel>
                        <TextBox Text="{Binding GeneratedXaml, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 Style="{StaticResource Md3.TextBox.Outlined}" />
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <md:Snackbar Grid.Row="1" MessageQueue="{Binding MessageQueue}" HorizontalAlignment="Center" />
    </Grid>
</Window>
