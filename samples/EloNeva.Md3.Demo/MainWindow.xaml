<Window x:Class="EloNeva.Md3.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:md3="clr-namespace:EloNeva.Md3.Controls;assembly=EloNeva.Md3.Controls"
        xmlns:local="clr-namespace:EloNeva.Md3.Demo"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:MainViewModel}"
        Title="Démo – thème MD3 EloNeva" Width="1100" Height="820"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{DynamicResource Md3.Brush.Surface}"
        Foreground="{DynamicResource Md3.Brush.OnSurface}"
        TextElement.Foreground="{DynamicResource Md3.Brush.OnSurface}"
        FontFamily="{DynamicResource Md3.FontFamily}"
        FontSize="{DynamicResource Md3.FontSize}">

    <!--
        Facultatif (guide.md, section 8) : cache des ombres pour les écrans très chargés
        ou le bureau à distance. Décommenter pour l'activer.
    <md:ShadowAssist.CacheMode>
        <BitmapCache EnableClearType="True" SnapsToDevicePixels="True" RenderAtScale="1" />
    </md:ShadowAssist.CacheMode>
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre d'application -->
        <Border Background="{DynamicResource Md3.Brush.SurfaceContainer}" Padding="24,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <md:PackIcon Kind="WhiteBalanceSunny" VerticalAlignment="Center" Foreground="{DynamicResource Md3.Brush.OnSurfaceVariant}" />
                    <ToggleButton Margin="8,0" Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  IsChecked="{Binding IsDark}" ToolTip="Mode clair / sombre" />
                    <md:PackIcon Kind="WeatherNight" VerticalAlignment="Center" Foreground="{DynamicResource Md3.Brush.OnSurfaceVariant}" />
                </StackPanel>
                <TextBlock Style="{StaticResource MaterialDesignTitleLargeTextBlock}" VerticalAlignment="Center"
                           Text="Application de démonstration" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">

                <!-- Saisie -->
                <md:Card Style="{StaticResource Md3.Card.Outlined}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MaterialDesignTitleMediumTextBlock}" Margin="0,0,0,16" Text="Formulaire" />
                        <UniformGrid Columns="3">
                            <TextBox Style="{StaticResource Md3.TextBox.Outlined}" Margin="0,0,16,16"
                                     md:HintAssist.Hint="Nom" md:HintAssist.HelperText="Obligatoire" />
                            <ComboBox Style="{StaticResource Md3.ComboBox.Outlined}" Margin="0,0,16,16"
                                      md:HintAssist.Hint="Service" ItemsSource="{Binding Services}" SelectedItem="{Binding Service}" />
                            <DatePicker Style="{StaticResource Md3.DatePicker.Outlined}" Margin="0,0,16,16"
                                        md:HintAssist.Hint="Date d'effet" SelectedDate="{Binding DateEffet}" />
                            <md3:DateRangePicker Margin="0,0,16,16" Hint="Période"
                                                 StartDate="{Binding Debut}" EndDate="{Binding Fin}" />
                            <TextBox Style="{StaticResource Md3.TextBox.Filled}" Margin="0,0,16,16"
                                     md:HintAssist.Hint="Commentaire" />
                        </UniformGrid>

                        <TextBlock Margin="0,0,0,8" Style="{StaticResource MaterialDesignLabelLargeTextBlock}"
                                   Foreground="{DynamicResource Md3.Brush.OnSurfaceVariant}" Text="Statuts" />
                        <ListBox Style="{StaticResource Md3.ChipListBox}" SelectionMode="Multiple" ItemsSource="{Binding Statuts}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Style="{StaticResource Md3.Button.Text}" Content="Annuler" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Md3.Button.Outlined}" Content="Brouillon" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Md3.Button.Filled}" Content="Enregistrer" />
                        </StackPanel>
                    </StackPanel>
                </md:Card>

                <!-- Table filtrable en data binding -->
                <md:Card Style="{StaticResource Md3.Card.Outlined}" Padding="20">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource Md3.Button.Tonal}" Content="Ajouter un client" Click="OnAjouterClient" Margin="0,0,8,0" />
                                <Button Style="{StaticResource Md3.Button.Outlined}" Content="Changer un statut" Click="OnChangerStatut" Margin="0,0,8,0" />
                                <Button Style="{StaticResource Md3.Button.Text}" Content="Effacer les filtres" Click="OnEffacerFiltres" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource MaterialDesignTitleMediumTextBlock}" VerticalAlignment="Center" Text="Clients" />
                        </DockPanel>
                        <TextBlock Margin="0,0,0,12" Style="{StaticResource MaterialDesignBodySmallTextBlock}"
                                   Foreground="{DynamicResource Md3.Brush.OnSurfaceVariant}"
                                   Text="{Binding FilteredCount, ElementName=ClientsGrid, StringFormat='Icône filtre dans chaque en-tête. {0} ligne(s) affichée(s).'}" />

                        <md3:FilterDataGrid x:Name="ClientsGrid" ItemsSource="{Binding Clients}" Height="380" IsReadOnly="True">
                            <md3:FilterDataGrid.Columns>
                                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" />
                                <DataGridTextColumn Header="Ville" Binding="{Binding Ville}" />
                                <DataGridTextColumn Header="Créé le" Binding="{Binding DateCreation, StringFormat=d}" />
                                <DataGridTextColumn Header="Montant" Binding="{Binding Montant, StringFormat=C0}"
                                                    md3:FilterDataGrid.IsFilterable="False" />
                                <DataGridTemplateColumn Header="Statut" SortMemberPath="Statut">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="local:Client">
                                            <Border HorizontalAlignment="Left" Padding="10,2" CornerRadius="{DynamicResource Md3.Shape.Small}"
                                                    Background="{DynamicResource Md3.Brush.SecondaryContainer}">
                                                <TextBlock Text="{Binding Statut}" Foreground="{DynamicResource Md3.Brush.OnSecondaryContainer}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </md3:FilterDataGrid.Columns>
                        </md3:FilterDataGrid>
                    </StackPanel>
                </md:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
